POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=dwh
POSTGRES_PORT=5433

# read-only role used by the MCP server (created by infra/postgres/init/02_mcp_reader.sh)
MCP_READER_USER=mcp_reader
MCP_READER_PASSWORD=mcp_reader

# embeddings for RAG (search_docs); never commit a real key
OPENAI_API_KEY=

# optional overrides (shown with their defaults)
# MCP_MAX_ROWS=200
# MCP_QUERY_TIMEOUT_MS=5000
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
